# Copie para .env e preencha. O arquivo .env NUNCA deve ir para o Git.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública (anon ou publishable). Usada só pelo servidor para login/renovação.
SUPABASE_ANON_KEY=
# Chave secreta (service_role ou secret). Dá acesso total: mantenha apenas no servidor.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_FOTOS=fotos-barbeiros

# --- Servidor ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info
# true quando estiver atrás de proxy reverso (para o IP real do cliente)
TRUST_PROXY=false

# --- Proteções ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
API_RATE_LIMIT_PER_MINUTE=300

# --- Desempenho ---
# Segundos que um login já validado é reaproveitado sem consultar o Supabase Auth (0 desliga).
# Logout, troca de senha/e-mail e senha redefinida pela API limpam na hora.
AUTH_CACHE_SECONDS=300
# Segundos de cache de serviços, barbeiros, perfis e agenda (0 desliga).
# Gravações pela API limpam na hora; o tempo só limita alterações feitas direto no Supabase.
DATA_CACHE_SECONDS=300

# --- Dados de exemplo (npm run db:seed) ---
# SEED_PASSWORD=barber123
